# ==========================================
# 1. Môi trường Python & Thư viện
# ==========================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage

# ==========================================
# 2. Node.js & Frontend Build
# ==========================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 3. File Cấu hình Môi trường & Bí mật (Secrets)
# ==========================================
.env
.env.local
.env.*.local
backend/.env

# ==========================================
# 4. Trọng số Mô hình AI (Nặng hàng chục MB)
# ==========================================
*.pt
*.pth
*.onnx
*.engine
backend/*.pt
data/models/*.pt
data/models/*.onnx
backend/data/models/*.pt
backend/data/models/*.onnx
!**/models/.gitkeep

# ==========================================
# 5. File Video Nặng (Dùng link Cloud CDN)
# ==========================================
*.mp4
*.avi
*.mkv
*.mov
*.flv
backend/*.mp4
data/videos/*.mp4
data/videos/*.avi
backend/data/videos/*.mp4
backend/data/videos/*.avi
!**/videos/.gitkeep

# ==========================================
# 6. Cơ sở dữ liệu SQLite
# ==========================================
*.db
*.sqlite
*.sqlite3
backend/traffic.db
backend/traffic.db-journal

# ==========================================
# 7. Dataset & Ảnh Vi Phạm (Đã lưu trữ Cloudinary)
# ==========================================
# Ảnh dataset
**/dataset/images/*
!**/dataset/images/.gitkeep

# Nhãn dataset tọa độ (.txt)
**/dataset/labels/*.txt
!**/dataset/labels/.gitkeep

# Ảnh bằng chứng vi phạm
**/violations/*
!**/violations/.gitkeep

# ==========================================
# 8. Hệ điều hành & Trình soạn thảo (IDE)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 9. Tài liệu nội bộ (Không đẩy lên Git)
# ==========================================
docs/

